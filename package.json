{
  "name": "claude-usage",
  "version": "0.1.0",
  "description": "Local web dashboard for Claude Code transcripts — token usage, costs, session history, and configuration audit. No external services.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch run server.ts",
    "build": "bun build --compile --target=bun-windows-x64 server.ts --outfile dist/claude-usage.exe",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "chokidar": "^4.0.0",
    "js-tiktoken": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
